# Varnam Saree Storefront Configuration
# Optional public origin for metadata, sharing images, robots and sitemap URLs.
# Set to your deployed HTTPS origin; blank/invalid values use http://localhost:3000.
SITE_URL=
# The npm dev/start scripts currently bind port 3000 and host 0.0.0.0.
PORT=
HOST=

# PostgreSQL application connection. SQL_PORT defaults to 5432; SQL_SSL defaults
# to false. Set SQL_SSL=true when your provider requires TLS (trusted certificate).
SQL_HOST=
SQL_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_SSL=
# Optional migration/seed identity. Leave both blank to use SQL_USER/SQL_PASSWORD.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Customer Google sign-in. Public web-app settings from Firebase Console:
# Project settings > General > Your apps > Web app > SDK setup/configuration.
# All FOUR are required. They are public identifiers, embedded at BUILD time.
# Configure in Vercel Production AND Preview as needed, then redeploy.
# Blank values disable account sign-in without affecting guest shopping.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only Firebase Admin credentials. Recommended for Vercel: all three.
# FIREBASE_PROJECT_ID MUST equal NEXT_PUBLIC_FIREBASE_PROJECT_ID.
# Copy the full PEM private key; actual newlines, literal \n, double-escaped
# newlines and CRLF are normalized. Never put it in any NEXT_PUBLIC_ variable.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Alternative: absolute path to an EXISTING securely mounted service-account
# JSON file. A local-computer path will not exist on Vercel. Leave blank when
# using the three fields above. Missing/invalid credentials fail closed.
GOOGLE_APPLICATION_CREDENTIALS=
# Enable Google provider and add deployed hostnames in Firebase Authentication
# > Settings > Authorized domains. Do not set FIREBASE_AUTH_EMULATOR_HOST in
# production; emulator identities are deliberately rejected.

# Studio admin login (server-only). Required: login fails closed when blank.
# Set both values in the deployment environment; never commit credentials.
ADMIN_LOGIN_EMAIL=
ADMIN_LOGIN_PASSWORD=
# Recommended: independent random signing secret (at least 32 random bytes).
# When blank, a domain-separated HMAC key is derived from ADMIN_LOGIN_PASSWORD.
# Rotating the password or signing secret invalidates existing admin cookies.
ADMIN_SESSION_SECRET=

# Razorpay: use a matching Test-mode or Live-mode key pair from your dashboard.
# Server-only secret. Never prefix RAZORPAY_KEY_SECRET with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Configure the same secret on the payment.captured webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=
