{
  "name": "varnam-saree",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "tsc --noEmit",
    "test:payments": "bun test tests/razorpay.test.mjs",
    "test:admin": "bun test tests/admin-session.test.mjs",
    "test:catalogue": "bun test tests/catalogue.test.mjs",
    "test:commerce": "bun test tests/commerce.test.mjs",
    "db:generate": "drizzle-kit generate --config=src/db/drizzle.config.ts",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "test:auth": "bun test tests/customer-auth.test.mjs tests/customer-account.test.mjs tests/firebase-config.test.mjs",
    "test:auth:cold-start": "bun tests/auth-sync-cold-start.mjs verification-import && bun tests/auth-sync-cold-start.mjs account-storage-import",
    "test:auth:http": "bun tests/auth-sync-http.mjs"
  },
  "dependencies": {
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "next": "^15.1.7",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "jose": "^5.9.6"
  },
  "resolutions": {
    "jose": "^5.9.6"
  }
}
